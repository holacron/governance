# Normalize text files to LF in the repo regardless of OS checkout.
# Editors/CI then see consistent diffs.
* text=auto eol=lf

# Ensure these common Windows-edited types are always LF in-repo.
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.ts     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.py     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf

# Treat these as binary so Git never tries to merge or re-encode them.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  text eol=lf
*.mp4  binary
*.pdf  binary
