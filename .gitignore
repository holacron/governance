# ───────────────────────────────────────────────────────────────
# Secrets — NEVER commit real credentials, API keys, or provider tokens.
# .env.example is the committed template; the live .env stays local.
# ───────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
!.env.example

# ───────────────────────────────────────────────────────────────
# Python
# ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/
.python-version
# Virtual envs (any common name)
.venv/
venv/
env/

# ───────────────────────────────────────────────────────────────
# Node / TypeScript (if the Sprint 0 spike picks Node)
# ───────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnp.*
dist/
*.tsbuildinfo

# ───────────────────────────────────────────────────────────────
# Testing / coverage
# ───────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
.nyc_output/

# ───────────────────────────────────────────────────────────────
# Local tooling & editor state
# ───────────────────────────────────────────────────────────────
.aider*
.cache/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/
*.code-workspace

# ───────────────────────────────────────────────────────────────
# Local runtime data / databases / scratch
# (the immutable ledger & agent registry live in managed Postgres, not here)
# ───────────────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
data/
/tmp/
*.log
