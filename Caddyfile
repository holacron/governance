# Caddy reverse proxy for the OLOCRON engage API.
#
# Caddy automatically provisions and renews a Let's Encrypt TLS certificate
# for api.kimberim.com (requires the DNS A-record to point at this server
# and ports 80+443 to be reachable from the internet).
#
# No manual cert management needed — this is the whole HTTPS config.

{
	# Global server options: generous timeouts for long SSE deliberation
	# streams (up to ~30 min) and slow clients.
	servers {
		timeouts {
			read_body 30s
			read_header 10s
			write 0s
			idle 30m
		}
	}
}

api.kimberim.com {
	# Stream immediately (flush_interval -1) — SSE deliberation events on
	# /deliberations/{run_id}/events must reach the client unbuffered.
	# No `encode` (compression): gzip would buffer event streams.
	reverse_proxy api:8787 {
		flush_interval -1
	}

	# Security headers.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Access + error logs.
	log {
		output stdout
		format console
	}
}
