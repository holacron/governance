# ───────────────────────────────────────────────────────────────
# kimberim-agents — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# ───────────────────────────────────────────────────────────────

# --- LLM provider keys (Sprint 0 spike uses at least one) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Harness runtime ---
# Comma-separated model IDs the gateway may route to (cheap + expensive tiers).
# Example: gpt-4o-mini,gpt-4o  OR  claude-3-5-haiku,claude-3-5-sonnet
HARNESS_MODELS=
# Per-run cost cap in USD before the run aborts.
HARNESS_COST_CAP_USD=5
# Port for the local harness API.
HARNESS_PORT=8787

# --- Postgres (immutable ledger + agent registry) ---
DATABASE_URL=postgresql://kimberim:kimberim@localhost:5432/kimberim_agents
